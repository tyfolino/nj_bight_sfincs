@@ -150,6 +150,8 @@ module snapwave_infragravity
     real*4, dimension(:,:), allocatable     :: Eforc, D, deltheta!, KKx, KKy, theta3
     real*4, dimension(:,:), allocatable     :: dphi3, k3, cg3!, Abnd   
     integer                                 :: valdensmax
+    integer                                 :: nseed, iseed
+    integer, dimension(:), allocatable      :: seed   ! nj-igseed-1: fixed RNG seed for the 400 random components
     !
     ! Constants
     pi  = 4.*atan(1.)    
@@ -281,6 +283,17 @@ module snapwave_infragravity
     enddo
     !
     ! Define random number between 0 and 1 for each wave component
+    !
+    ! nj-igseed-1: RANDOM_NUMBER was never seeded, and libgfortran seeds itself from the OS,
+    ! so every run drew different components and SnapWave (via shinc2ig) did not repeat itself.
+    ! Re-seed with a FIXED value on every call: the same sample of components at every boundary
+    ! point and every call, independent of run history (restarts, dtwave, number of points).
+    call random_seed(size=nseed)
+    allocate(seed(nseed))
+    seed = (/(20121029 + 7919*iseed, iseed=1,nseed)/)
+    call random_seed(put=seed)
+    deallocate(seed)
+    !
     do i=1,K
         call RANDOM_NUMBER(P0(i)) 
         P0(i)=0.99*P0(i)+0.01/2 ! TL: as in Matlab: Define random number between ~0.025 and 0975 for each wave component
