diff --git a/source/src/snapwave/snapwave_infragravity.f90 b/source/src/snapwave/snapwave_infragravity.f90
index aee3904..1215465 100644
--- a/source/src/snapwave/snapwave_infragravity.f90
+++ b/source/src/snapwave/snapwave_infragravity.f90
@@ -211,6 +211,8 @@ module snapwave_infragravity
     real*4, dimension(:,:), allocatable     :: S_array    
     integer                                 :: i=0, ii, nang, nfreq, peakf
     integer                                 :: firstp, lastp, M, K    
+    integer                                 :: nseed, iseed
+    integer, dimension(:), allocatable      :: seed
     real*4                                  :: pi, g, sprdthr
     !
     ! Internal variables - for part 2: build_etdir    
@@ -361,6 +363,18 @@ module snapwave_infragravity
     enddo
     !
     ! Define random number between 0 and 1 for each wave component
+    !
+    ! Seed the generator with a fixed value first, on every call. Unseeded, gfortran seeds
+    ! RANDOM_NUMBER from the operating system, so every run drew a different set of
+    ! components and IG-on runs did not reproduce. Re-seeding on every call gives every
+    ! boundary point and every wave update the same sample, independent of run history.
+    !
+    call random_seed(size=nseed)
+    allocate(seed(nseed))
+    seed = (/(1234567 + 7919*iseed, iseed=1,nseed)/)
+    call random_seed(put=seed)
+    deallocate(seed)
+    !
     do i=1,K
         call RANDOM_NUMBER(P0(i)) 
         P0(i)=0.99*P0(i)+0.01/2 ! TL: as in Matlab: Define random number between ~0.025 and 0975 for each wave component
