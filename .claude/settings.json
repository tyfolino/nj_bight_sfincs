{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "guard: queued-job md5 / rmtree flags / git commit"
          }
        ]
      }
    ]
  }
}
