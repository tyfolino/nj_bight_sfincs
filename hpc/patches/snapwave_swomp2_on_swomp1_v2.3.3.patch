+   subroutine swomp_levels(n, ntheta, prev, inner, indx, order, start, nlev)
+   ! nj-swomp-2: level schedule of one sweep direction. Visiting inner nodes in sweep order
+   ! (c = position), each gets level = max(lb, 1 + level of every inner upwind node earlier
+   ! in the order), then pushes lb = its level + 1 onto every inner upwind node LATER in the
+   ! order. So for every pair (k, j in prev(:,:,k)) the later node has the strictly higher
+   ! level. Non-inner nodes are never written in the sweep (no Neumann nodes here), so they
+   ! impose nothing. Output: order(start(L):start(L+1)-1) = the positions of level L,
+   ! ascending. One pass, O(2*ntheta*n), integer only.
+   implicit none
+   integer, intent(in)  :: n, ntheta
+   integer, intent(in)  :: prev(2, ntheta, n), indx(n)
+   logical, intent(in)  :: inner(n)
+   integer, intent(out) :: order(n), start(n + 1), nlev
+   integer, allocatable :: pos(:), lev(:), lb(:), nxt(:)
+   integer              :: c, k, j, m, it, L
+   !
+   allocate(pos(n), lev(n), lb(n))
+   do c = 1, n
+      pos(indx(c)) = c
+   enddo
+   lev  = 0
+   lb   = 1
+   nlev = 0
+   do c = 1, n
+      k = indx(c)
+      if (.not. inner(k)) cycle
+      L = lb(k)
+      do it = 1, ntheta
+         do m = 1, 2
+            j = prev(m, it, k)
+            if (j < 1 .or. j == k) cycle
+            if (.not. inner(j)) cycle
+            if (pos(j) < c) L = max(L, lev(j) + 1)
+         enddo
+      enddo
+      lev(k) = L
+      nlev   = max(nlev, L)
+      do it = 1, ntheta
+         do m = 1, 2
+            j = prev(m, it, k)
+            if (j < 1 .or. j == k) cycle
+            if (.not. inner(j)) cycle
+            if (pos(j) > c) lb(j) = max(lb(j), L + 1)
+         enddo
+      enddo
+   enddo
+   allocate(nxt(nlev + 1))
+   nxt = 0
+   do c = 1, n
+      k = indx(c)
+      if (inner(k)) nxt(lev(k)) = nxt(lev(k)) + 1
+   enddo
+   start(1) = 1
+   do L = 1, nlev
+      start(L + 1) = start(L) + nxt(L)
+   enddo
+   nxt(1:nlev) = start(1:nlev)
+   do c = 1, n
+      k = indx(c)
+      if (.not. inner(k)) cycle
+      order(nxt(lev(k))) = c
+      nxt(lev(k)) = nxt(lev(k)) + 1
+   enddo
+   deallocate(pos, lev, lb, nxt)
+   end subroutine swomp_levels
+
