+   subroutine swomp_zero2(a, n1, n2)
+   ! a = 0.0, column by column in parallel (also spreads the first-touch page faults)
+   implicit none
+   integer, intent(in)   :: n1, n2
+   real*4, intent(inout) :: a(n1, n2)
+   integer               :: j
+   !$omp parallel do schedule(static) private(j)
+   do j = 1, n2
+      a(:, j) = 0.0
+   enddo
+   !$omp end parallel do
+   end subroutine swomp_zero2
+
+   real*4 function swomp_maxval(a, n)
+   ! MAXVAL(a) computed in parallel, bit-identical to gfortran's serial intrinsic:
+   ! the intrinsic takes the first non-NaN element (a >= -Inf), then replaces only on a
+   ! STRICTLY greater element, so it returns the FIRST maximum in array order (this matters
+   ! only for +0/-0) and skips NaNs; all-NaN -> NaN, empty -> -HUGE. Each contiguous chunk
+   ! does the same, and the chunk results are combined in chunk order with the same rule.
+   !$ use omp_lib
+   implicit none
+   integer, intent(in) :: n
+   real*4, intent(in)  :: a(n)
+   integer             :: nt, it, i, i0, i1
+   real*4              :: lim
+   logical             :: got
+   real*4,  allocatable :: part(:)
+   logical, allocatable :: pgot(:)
+   real*4, parameter   :: ninf = -huge(1.0_4)
+   !
+   nt = 1
+   !$ nt = omp_get_max_threads()
+   nt = max(1, min(nt, n / 65536))
+   allocate(part(nt), pgot(nt))
+   !$omp parallel do schedule(static,1) private(it, i, i0, i1, lim, got) num_threads(nt)
+   do it = 1, nt
+      i0  = int((int(it - 1, 8)*n)/nt) + 1
+      i1  = int((int(it, 8)*n)/nt)
+      got = .false.
+      lim = -ieee_inf()
+      do i = i0, i1
+         if (.not. got) then
+            if (a(i) >= lim) then
+               lim = a(i)
+               got = .true.
+            endif
+         elseif (a(i) > lim) then
+            lim = a(i)
+         endif
+      enddo
+      part(it) = lim
+      pgot(it) = got
+   enddo
+   !$omp end parallel do
+   got = .false.
+   lim = -ieee_inf()
+   do it = 1, nt
+      if (.not. pgot(it)) cycle
+      if (.not. got) then
+         lim = part(it)
+         got = .true.
+      elseif (part(it) > lim) then
+         lim = part(it)
+      endif
+   enddo
+   if (got) then
+      swomp_maxval = lim
+   elseif (n > 0) then
+      swomp_maxval = ieee_nan()
+   else
+      swomp_maxval = ninf
+   endif
+   deallocate(part, pgot)
+   contains
+      real*4 function ieee_inf()
+      real*4 :: big
+      big = huge(1.0_4)
+      ieee_inf = big*2.0
+      end function ieee_inf
+      real*4 function ieee_nan()
+      real*4 :: z
+      z = 0.0
+      ieee_nan = transfer(int(z'7FC00000', 4), 1.0_4)
+      end function ieee_nan
+   end function swomp_maxval
    
 end module snapwave_solver 
